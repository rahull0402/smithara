# Server-side only — set these in Vercel (Project Settings > Environment Variables) or a local .env.local.
# Never prefix them with NEXT_PUBLIC_ / VITE_ or reference them from browser code.

# Google Apps Script web app URL (must end in /exec)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec

# Must exactly match CONFIG.API_SECRET in the deployed Apps Script (not a Gmail password)
GOOGLE_APPS_SCRIPT_SECRET=replace-with-a-long-random-string
